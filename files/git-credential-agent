#!/bin/bash
# Git credential helper for agent shells. Bash 3.2 compatible.
# Returns the agent's PAT for the owner of the repo git asks about, read from
# ~/.config/agent-git/tokens/<owner>. Any other host, or an owner with no token
# file, gets nothing, so git fails rather than falling back to another credential.
set -euo pipefail

TOKENS="$HOME/.config/agent-git/tokens"

case ${1:-} in
  get) ;;
  store|erase) cat >/dev/null; exit 0 ;;
  *) echo "git-credential-agent: action must be get, store or erase" >&2; exit 1 ;;
esac

host="" path=""
while IFS='=' read -r key value; do
  case $key in host) host=$value ;; path) path=$value ;; esac
done

[ "$host" = github.com ] || exit 0
owner=${path%%/*}
case $owner in ''|-*|*-|*[!A-Za-z0-9-]*) exit 0 ;; esac
[ -r "$TOKENS/$owner" ] || exit 0
printf 'username=%s\npassword=%s\n' "$owner" "$(cat "$TOKENS/$owner")"
