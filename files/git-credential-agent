#!/bin/bash
# Git credential helper for the agent's GitHub App. Bash 3.2 compatible.
# Uses openssl and curl from the OS by absolute path, and jq (bundled with macOS 15+).
#
#   git-credential-agent --app-id <id> --installation-id <id> get   prints a one-hour installation token
#   git-credential-agent --app-id <id> installations                prints "<owner> <installation-id>" lines
set -euo pipefail

OPENSSL=/usr/bin/openssl CURL=/usr/bin/curl
JQ=/usr/bin/jq; [ -x "$JQ" ] || JQ=$(command -v jq) || { echo "git-credential-agent: jq not found" >&2; exit 1; }
KEY="$HOME/.config/agent-git/app.pem"
API=https://api.github.com

die() { echo "git-credential-agent: $*" >&2; exit 1; }

app_id="" installation_id="" action=""
while [ $# -gt 0 ]; do
  case $1 in
    --app-id) app_id=${2:-}; shift 2 ;;
    --installation-id) installation_id=${2:-}; shift 2 ;;
    get|store|erase|installations) action=$1; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done
case $app_id in ''|*[!0-9]*) die "--app-id must be numeric" ;; esac

# git sends store and erase after a fill; tokens are minted fresh, so there is nothing to keep.
case $action in store|erase) cat >/dev/null; exit 0 ;; esac

b64url() { "$OPENSSL" base64 -A | tr '+/' '-_' | tr -d '='; }

# A JWT signed with the App key, valid for nine minutes; GitHub allows at most ten.
jwt() {
  [ -r "$KEY" ] || die "cannot read $KEY"
  local now header payload
  now=$(date +%s)
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)
  printf '%s.%s.%s' "$header" "$payload" \
    "$(printf '%s.%s' "$header" "$payload" | "$OPENSSL" dgst -sha256 -sign "$KEY" -binary | b64url)"
}

# The JWT goes to curl on stdin, so it never appears in the process list.
github() {
  printf 'header = "Authorization: Bearer %s"\n' "$(jwt)" \
    | "$CURL" --config - -fsS -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' "$@"
}

case $action in
  get)
    cat >/dev/null
    case $installation_id in ''|*[!0-9]*) die "--installation-id must be numeric" ;; esac
    resp=$(github -X POST "$API/app/installations/$installation_id/access_tokens") \
      || die "GitHub refused the token request for installation $installation_id"
    token=$(printf '%s' "$resp" | "$JQ" -er .token) || die "no token in GitHub's reply"
    printf 'username=x-access-token\npassword=%s\n' "$token"
    ;;
  installations)
    resp=$(github "$API/app/installations?per_page=100") || die "GitHub refused to list installations"
    printf '%s' "$resp" | "$JQ" -r '.[] | "\(.account.login) \(.id)"'
    ;;
  *) die "action must be get, store, erase or installations" ;;
esac
