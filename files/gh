#!/usr/bin/env bash
# Agent-only gh: get the repo owner's token from git's credential chain as GH_TOKEN, then run the real gh.
# Bash 3.2 compatible.
real_gh=""
IFS=:
for d in $PATH; do
  [ -x "$d/gh" ] && [ ! "$d/gh" -ef "$0" ] && { real_gh="$d/gh"; break; }
done
unset IFS
[ -n "$real_gh" ] || { echo "gh: real gh not found on PATH" >&2; exit 127; }

# The agent acts as you, so its approvals count as yours. Refuse them here; this
# is a speed bump, not a boundary. Flags may come before the subcommand.
pr="" review="" api="" approve_flag="" approve_word="" input="" at_field="" path_risky="" prev=""
for a in "$@"; do
  case $prev in -b|--body) prev=""; continue ;; -F|--field) case $a in *=@*) at_field=1 ;; esac ;; esac
  case $a in pr) pr=1 ;; review) review=1 ;; api) api=1 ;; esac
  case $a in --approve*|-a*) approve_flag=1 ;; esac
  case $a in *APPROVE*) approve_word=1 ;; esac
  case $a in --input|--input=*) input=1 ;; esac
  case $a in -F?*=@*|--field=*=@*) at_field=1 ;; esac
  case $a in graphql|*/reviews*) path_risky=1 ;; esac
  prev=$a
done
# Under api, --input and @file fields would hide the request body from this check.
if { [ -n "$pr" ] && [ -n "$review" ] && [ -n "$approve_flag" ]; } \
   || { [ -n "$api" ] && { [ -n "$approve_word" ] || [ -n "$input" ] || { [ -n "$at_field" ] && [ -n "$path_risky" ]; }; }; }; then
  echo "gh: agents do not approve PRs; leave a comment review instead" >&2; exit 1
fi

if [ -z "${GH_TOKEN:-}" ]; then
  owner="" prev=""
  for a in "$@"; do
    o=""
    case $prev in -R|--repo) o=$a ;; esac
    case $a in --repo=*) o=${a#--repo=} ;; -R?*) o=${a#-R} ;; esac
    if [ -n "$o" ]; then o=${o#https://}; o=${o#github.com/}; owner=${o%%/*}; fi
    prev=$a
  done
  if [ -z "$owner" ]; then
    url=$(git remote get-url origin 2>/dev/null || true)
    case $url in *github.com[:/]*) o=${url#*github.com[:/]}; owner=${o%%/*} ;; esac
  fi
  owner=${owner:-${AGENT_GH_DEFAULT_OWNER:-}}
  token=$(printf 'protocol=https\nhost=github.com\npath=%s/_.git\n\n' "$owner" \
          | git credential fill 2>/dev/null | sed -n 's/^password=//p')
  [ -n "$token" ] && export GH_TOKEN="$token"
fi
exec "$real_gh" "$@"
